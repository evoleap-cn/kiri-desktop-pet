{
  "name": "clawd-desktop-pet",
  "version": "0.2.0",
  "description": "A Linux desktop pet with rich pixel-art animations and external hook support.",
  "homepage": "https://github.com/zgyk4167/clawd-desktop-pet",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "prebuildify",
    "postinstall": "node-gyp-build || echo 'Prebuilds not found, will use clipboard fallback'",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --linux",
    "dev:acp": "vite --config src/acp/vite.config.ts",
    "build:acp": "vite build --config src/acp/vite.config.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "clawd",
    "desktop-pet",
    "electron",
    "linux",
    "pixel-art"
  ],
  "author": {
    "name": "Frank"
  },
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.clawd.desktop.pet",
    "productName": "Clawd Desktop Pet",
    "linux": {
      "category": "Utility",
      "maintainer": "Frank <zgyk4167@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "src/**/*",
      "assets/svg/**/*",
      "hooks/**/*",
      "dist/acp/**/*"
    ]
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "marked": "^15.0.7",
    "node-gyp": "^12.2.0",
    "node-gyp-build": "^4.8.4",
    "prebuildify": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
