{
  "name": "clawd-desktop-pet",
  "version": "0.2.0",
  "description": "A Linux desktop pet with rich pixel-art animations and external hook support.",
  "homepage": "https://github.com/zgyk4167/clawd-desktop-pet",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "prebuildify",
    "postinstall": "node-gyp-build || echo 'Prebuilds not found, will use clipboard fallback'",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --linux",
    "dev:acp": "cd src/acp && vite",
    "build:acp": "cd src/acp && vite build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "clawd",
    "desktop-pet",
    "electron",
    "linux",
    "pixel-art"
  ],
  "author": {
    "name": "Frank"
  },
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.clawd.desktop.pet",
    "productName": "Clawd Desktop Pet",
    "linux": {
      "category": "Utility",
      "maintainer": "Frank <zgyk4167@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "src/**/*",
      "assets/svg/**/*",
      "hooks/**/*",
      "dist/acp/**/*"
    ]
  },
  "dependencies": {
    "@kobalte/core": "^0.13.10",
    "@pierre/diffs": "^1.1.0-beta.18",
    "@shikijs/transformers": "^3.9.2",
    "@solid-primitives/active-element": "^2.1.3",
    "@solid-primitives/audio": "^1.4.2",
    "@solid-primitives/event-bus": "^1.1.2",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/scroll": "^2.1.3",
    "@solid-primitives/storage": "^4.3.2",
    "@solid-primitives/timer": "^1.4.4",
    "@solid-primitives/websocket": "^1.3.1",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "@tanstack/solid-query": "^5.91.4",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "diff": "^7.0.0",
    "dompurify": "^3.3.1",
    "effect": "^3.11.9",
    "fuzzysort": "^3.1.0",
    "ghostty-web": "github:anomalyco/ghostty-web",
    "katex": "^0.16.27",
    "luxon": "^3.5.0",
    "marked": "^15.0.7",
    "marked-katex-extension": "^5.1.6",
    "marked-shiki": "^1.2.0",
    "morphdom": "^2.7.8",
    "motion": "^12.34.5",
    "motion-dom": "^12.34.3",
    "node-addon-api": "^8.0.0",
    "remeda": "^2.19.3",
    "shiki": "^1.24.2",
    "solid-js": "^1.9.3",
    "solid-list": "^0.3.0",
    "strip-ansi": "^7.1.2",
    "virtua": "^0.49.1",
    "ws": "^8.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@solid-primitives/bounds": "^0.1.3",
    "@solid-primitives/event-listener": "^2.4.5",
    "@solid-primitives/media": "^2.3.3",
    "@solid-primitives/resize-observer": "^2.1.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/katex": "^0.16.7",
    "@types/luxon": "^3.4.2",
    "autoprefixer": "^10.5.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "node-gyp": "^12.2.0",
    "node-gyp-build": "^4.8.4",
    "postcss": "^8.5.10",
    "prebuildify": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-solid": "^2.10.2"
  }
}
